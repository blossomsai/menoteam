# Central Agent Gateway only. Replace every placeholder through your deployment secret manager.
# After the first deploy, use scripts/gateway-admin.mjs instead of editing the endpoint JSON or copying raw tokens by hand.
AGENT_GATEWAY_MASTER_KEY=replace-with-a-separate-long-random-secret
# Leave these empty until gateway-admin creates the first Master handoff.
AGENT_GATEWAY_CONNECTORS_JSON='[]'
AGENT_GATEWAY_MASTER_ENDPOINT=
AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=3100
AGENT_GATEWAY_ALLOWED_HOSTS=agents.example.com
AGENT_GATEWAY_TRUST_PROXY=true

# Optional self-service pairing. Set all five values together to enable /agents.
AGENT_GATEWAY_REGISTRY_FILE=/data/connectors.json
AGENT_GATEWAY_PUBLIC_URL=https://agents.example.com
AGENT_GATEWAY_ADMIN_PASSWORD=replace-with-a-separate-admin-password
WORK_MAP_MCP_URL=https://team.example.com/mcp
WORK_MAP_MCP_API_KEY=replace-with-the-work-map-upstream-key

# The only Slack app credentials in the system live on this central service.
SLACK_BOT_TOKEN=xoxb-replace-through-secret-manager
SLACK_SIGNING_SECRET=replace-through-secret-manager
SLACK_BOT_USER_ID=U_REPLACE
SLACK_ALLOWED_USER_IDS=U_REPLACE_OWNER,U_REPLACE_COLLEAGUE
SLACK_ALLOWED_CHANNEL_IDS=C_REPLACE_TEAM_CHANNEL
