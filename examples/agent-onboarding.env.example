# Copy this template to a local, ignored file or secret-manager scope.
# Never commit a filled copy and never paste bearer or Discord tokens into chat.
WORK_MAP_MCP_URL=https://team.example.net/mcp
WORK_MAP_MCP_API_KEY=read-this-from-your-secret-manager
WORK_MAP_TEAMMATE_REF=teammate_replace_me
WORK_MAP_AGENT_ADDRESS=replace-with-native-channel-address
# hermes | openclaw | codex | pi | other
WORK_MAP_HARNESS=hermes
WORK_MAP_ROLE=team-agent
# discord | slack | none
WORK_MAP_CHANNEL=discord
WORK_MAP_MASTER_MENTION=@Master
DISCORD_CHANNEL_ID=replace-with-selected-discord-channel-id

# Hermes Discord policy (non-secret; omit if another harness owns the channel).
DISCORD_ALLOW_BOTS=mentions
DISCORD_BOTS_REQUIRE_INLINE_MENTION=true
DISCORD_AUTO_THREAD=false
DISCORD_REACTIONS=false
DISCORD_HISTORY_BACKFILL=false

# DISCORD_BOT_TOKEN belongs to the native Hermes/OpenClaw secret path.
# Do not put it in this repository template.
# For WORK_MAP_ROLE=master, omit WORK_MAP_TEAMMATE_REF and
# WORK_MAP_AGENT_ADDRESS; use examples/master-onboarding.env.example instead.
