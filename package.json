{
  "name": "menoteam-work-map",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": ["dist", "migrations", "Dockerfile", "docker-compose.yml", "pnpm-workspace.yaml", ".env.example"],
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-repository.test.ts",
    "test:watch": "vitest",
    "onboarding:check": "node scripts/check-agent-prereqs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "export": "tsx src/db/export-cli.ts",
    "backup": "tsx src/db/backup-cli.ts",
    "restore": "tsx src/db/restore-cli.ts",
    "import:safedriver": "tsx src/importer/apply-safedriver.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
