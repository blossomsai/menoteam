{
  "name": "menoteam-work-map",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "gateway:dev": "tsx src/gateway/main.ts",
    "gateway:start": "node dist/gateway/main.js",
    "gateway:admin": "node scripts/gateway-admin.mjs",
    "gateway:admin:check": "node scripts/gateway-admin-self-check.mjs",
    "plugin:check": "node plugins/menoteam-agent/scripts/self-check.mjs",
    "hermes:check": "node connectors/hermes/self-check.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-repository.test.ts",
    "test:watch": "vitest",
    "onboarding:check": "node scripts/check-agent-prereqs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "export": "tsx src/db/export-cli.ts",
    "backup": "tsx src/db/backup-cli.ts",
    "restore": "tsx src/db/restore-cli.ts",
    "import:safedriver": "tsx src/importer/apply-safedriver.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
